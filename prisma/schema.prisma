generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum AccountType {
  CASH
  BANK
  DIGITAL_WALLET
  CREDIT_CARD
  SAVINGS
  INVESTMENT
  CRYPTO
  FOREIGN_CURRENCY
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  INVESTMENT
  DEBT_PAYMENT
}

enum InvestmentType {
  USD_OFICIAL
  USD_BLUE
  USD_MEP
  USD_CCL
  CRYPTO
  FIXED_TERM
  STOCKS
  BONDS
  FUND
  OTHER
}

enum DebtDirection {
  I_OWE
  THEY_OWE
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model Profile {
  id               String   @id
  email            String   @unique
  name             String?
  whatsappNumber   String?  @unique
  // Código secreto para vincular WhatsApp en 1 toque: el usuario abre WhatsApp
  // con "Vincular <code>" pre-armado y el bot captura su número real (cero tipeo).
  whatsappLinkCode String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Reporte semanal por email — preferencia de envío por usuario.
  // weeklyReportDay: 0=Domingo … 6=Sábado (JS getDay). weeklyReportHour: 0–23 hora ARG.
  weeklyReportEnabled Boolean @default(false)
  weeklyReportDay     Int?
  weeklyReportHour    Int?

  // Recordatorio diario por WhatsApp — pregunta a las 20hs ARG si registró sus gastos.
  dailyReminderEnabled Boolean @default(false)

  // Reactivación: timestamp del nudge de "cargá tu primer movimiento" enviado a
  // usuarios que se registraron y no cargaron nada. Null = todavía no se envió.
  reactivationNudgeAt DateTime?

  // Suscripción (monetización). plan: "free" | "premium". El acceso real se
  // decide por premiumUntil (lo renueva/corta el webhook de MercadoPago); así
  // un pago vencido cae a free solo, sin tocar nada más.
  plan            String    @default("free")
  premiumUntil    DateTime?
  mpPreapprovalId String? // id de la suscripción (preapproval) en MercadoPago

  // Tester: ve las features en desarrollo (flag "testers") antes que el resto,
  // para verificarlas antes de prenderlas para todos. Ver lib/feature-flags.ts.
  isTester Boolean @default(false)

  // Google (Calendar + Tasks). refresh token cifrado; se usa para sacar access
  // tokens frescos. Null = no conectó su Google.
  googleRefreshToken String?
  googleEmail        String?
  googleConnectedAt  DateTime?
  googleAccessToken  String? // cache del access token (cifrado)
  googleTokenExpiry  DateTime?

  accounts              Account[]
  categories            Category[]
  transactions          Transaction[]
  investments           Investment[]
  debts                 Debt[]
  creditPurchases       CreditPurchase[]
  recurringTransactions RecurringTransaction[]
  budgets               Budget[]
  goals                 Goal[]
  pushSubscriptions     PushSubscription[]
  mfaRecoveryCodes      MfaRecoveryCode[]
  gruposCreados         GrupoGasto[]           @relation("GruposCreados")
  gruposMiembro         MiembroGrupo[]         @relation("GruposMiembro")
  tasks                 Task[]
  reminders             Reminder[]
  recurringReminders    RecurringReminder[]
  newsletterConfig      NewsletterConfig?
  newsletterEditions    NewsletterEdition[]
  briefSources          BriefSource[]
  discoveryCandidates   DiscoveryCandidate[]
  briefFeedback         BriefFeedback[]

  @@map("profiles")
}

model Account {
  id        String      @id @default(cuid())
  userId    String
  user      Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      AccountType
  currency  String      @default("ARS")
  balance   Decimal     @default(0) @db.Decimal(15, 2)
  color     String?
  icon      String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  transactionsFrom      Transaction[]          @relation("FromAccount")
  transactionsTo        Transaction[]          @relation("ToAccount")
  creditPurchases       CreditPurchase[]
  recurringTransactions RecurringTransaction[]
  goals                 Goal[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id        String          @id @default(cuid())
  userId    String
  user      Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String?
  color     String?
  type      TransactionType
  parentId  String?
  parent    Category?       @relation("SubCategories", fields: [parentId], references: [id])
  children  Category[]      @relation("SubCategories")
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())

  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
  @@map("categories")
}

model Transaction {
  id               String          @id @default(cuid())
  userId           String
  user             Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             TransactionType
  amount           Decimal         @db.Decimal(15, 2)
  currency         String          @default("ARS")
  amountARS        Decimal?        @db.Decimal(15, 2)
  exchangeRate     Decimal?        @db.Decimal(10, 4)
  description      String?
  date             DateTime
  categoryId       String?
  category         Category?       @relation(fields: [categoryId], references: [id])
  accountId        String?
  account          Account?        @relation("FromAccount", fields: [accountId], references: [id])
  toAccountId      String?
  toAccount        Account?        @relation("ToAccount", fields: [toAccountId], references: [id])
  creditPurchaseId String?
  creditPurchase   CreditPurchase? @relation(fields: [creditPurchaseId], references: [id])
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, createdAt]) // racha: días activos ordenados por createdAt
  @@map("transactions")
}

model Investment {
  id           String         @id @default(cuid())
  userId       String
  user         Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         InvestmentType
  currency     String
  amount       Decimal        @db.Decimal(15, 2)
  currentValue Decimal?       @db.Decimal(15, 2)
  ticker       String?
  units        Decimal?       @db.Decimal(15, 8)
  purchaseDate DateTime
  notes        String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
  @@map("investments")
}

model Debt {
  id          String        @id @default(cuid())
  userId      String
  user        Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction   DebtDirection
  personName  String
  description String?
  totalAmount Decimal       @db.Decimal(15, 2)
  currency    String        @default("ARS")
  paidAmount  Decimal       @default(0) @db.Decimal(15, 2)
  dueDate     DateTime?
  isCompleted Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  installments DebtInstallment[]

  @@index([userId])
  @@map("debts")
}

model DebtInstallment {
  id        String    @id @default(cuid())
  debtId    String
  debt      Debt      @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount    Decimal   @db.Decimal(15, 2)
  dueDate   DateTime
  isPaid    Boolean   @default(false)
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("debt_installments")
}

model CreditPurchase {
  id                String   @id @default(cuid())
  userId            String
  user              Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id])
  description       String
  totalAmount       Decimal  @db.Decimal(15, 2)
  currency          String   @default("ARS")
  totalInstallments Int
  paidInstallments  Int      @default(0)
  firstPaymentDate  DateTime
  categoryId        String?
  createdAt         DateTime @default(now())

  transactions Transaction[]
  installments CreditInstallment[]

  @@index([userId])
  @@map("credit_purchases")
}

model CreditInstallment {
  id                Int            @id @default(autoincrement())
  creditPurchaseId  String
  creditPurchase    CreditPurchase @relation(fields: [creditPurchaseId], references: [id], onDelete: Cascade)
  installmentNumber Int
  amount            Decimal        @db.Decimal(15, 2)
  dueDate           DateTime
  isPaid            Boolean        @default(false)
  paidAt            DateTime?
  createdAt         DateTime       @default(now())

  @@index([creditPurchaseId, isPaid, dueDate]) // agenda/vencimientos: cuotas impagas por fecha
  @@map("credit_installments")
}

model RecurringTransaction {
  id           String             @id @default(cuid())
  userId       String
  user         Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         TransactionType
  amount       Decimal            @db.Decimal(15, 2)
  currency     String             @default("ARS")
  description  String
  categoryId   String?
  category     Category?          @relation(fields: [categoryId], references: [id])
  accountId    String?
  account      Account?           @relation(fields: [accountId], references: [id])
  frequency    RecurringFrequency
  dayOfMonth   Int?
  dayOfWeek    Int?
  startDate    DateTime
  endDate      DateTime?
  lastExecuted DateTime?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([userId])
  @@index([userId, isActive])
  @@map("recurring_transactions")
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  amount     Decimal  @db.Decimal(15, 2)
  currency   String   @default("ARS")
  month      Int
  year       Int
  alertAt    Int      @default(80)
  alertedPct Int      @default(0) // mayor umbral ya notificado este mes (evita spam diario)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
  @@map("budgets")
}

model Goal {
  id            String    @id @default(cuid())
  userId        String
  user          Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Decimal   @db.Decimal(15, 2)
  currentAmount Decimal   @default(0) @db.Decimal(15, 2)
  currency      String    @default("ARS")
  deadline      DateTime?
  icon          String?
  color         String?
  accountId     String?
  account       Account?  @relation(fields: [accountId], references: [id])
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([userId, isCompleted])
  @@map("goals")
}

// Tareas / pendientes del día a día (experimento: convertir control.io en
// asistente de vida, no solo de finanzas). title cifrado como el resto.
model Task {
  id        String    @id @default(cuid())
  userId    String
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, done, dueDate])
  @@map("tasks")
}

// Recordatorios con hora exacta ("haceme acordar en 5 min de X"). Se disparan
// por /api/cron/reminders (push + WhatsApp) cuando remindAt <= ahora. text cifrado.
model Reminder {
  id        String   @id @default(cuid())
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  remindAt  DateTime
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([sent, remindAt])
  @@map("reminders")
}

// Recordatorios RECURRENTes ("todos los días lun-vie a las 8:00: X"). A
// diferencia de Reminder (una sola vez), se repiten según daysOfWeek + hora.
// Los dispara /api/cron/reminders (corre cada minuto) comparando la hora ARG.
// text cifrado como el resto.
model RecurringReminder {
  id          String    @id @default(cuid())
  userId      String
  user        Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String
  link        String? // link opcional que se manda junto al recordatorio (cifrado)
  daysOfWeek  Int[] // 0=Domingo … 6=Sábado (JS getDay). Lun-Vie = [1,2,3,4,5]
  hour        Int // 0–23 (hora ARG)
  minute      Int // 0–59 (hora ARG)
  isActive    Boolean   @default(true)
  lastFiredOn DateTime? @db.Date // último día (ARG) que disparó, para no duplicar
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@map("recurring_reminders")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

model MfaRecoveryCode {
  id         String    @id @default(cuid())
  userId     String
  user       Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt])
  @@map("mfa_recovery_codes")
}

// ─────────────────────────────────────────────
// GRUPOS / GASTOS COMPARTIDOS
// ─────────────────────────────────────────────

model GrupoGasto {
  id          String  @id @default(cuid())
  nombre      String
  descripcion String?
  userId      String
  user        Profile @relation("GruposCreados", fields: [userId], references: [id], onDelete: Cascade)

  // Link de invitación REUSABLE (estilo invite de grupo de WhatsApp): cualquiera
  // con el link se une. Se genera lazy la primera vez que se comparte.
  inviteToken String? @unique

  miembros     MiembroGrupo[]
  gastos       GastoGrupo[]
  invitaciones GrupoInvitacion[]

  creadoEn    DateTime  @default(now())
  archivadoEn DateTime?

  @@index([userId])
  @@map("grupos_gasto")
}

model MiembroGrupo {
  id        String     @id @default(cuid())
  grupoId   String
  grupo     GrupoGasto @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  userId    String?
  user      Profile?   @relation("GruposMiembro", fields: [userId], references: [id])
  nombre    String
  email     String?
  esCreador Boolean    @default(false)
  uniEn     DateTime   @default(now())

  gastosPagados GastoGrupo[]    @relation("PagadoPor")
  divisiones    DivisionGasto[]

  @@unique([grupoId, userId])
  @@index([grupoId])
  @@map("miembros_grupo")
}

model GastoGrupo {
  id          String          @id @default(cuid())
  grupoId     String
  grupo       GrupoGasto      @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  descripcion String
  monto       Decimal         @db.Decimal(15, 2)
  pagadoPorId String
  pagadoPor   MiembroGrupo    @relation("PagadoPor", fields: [pagadoPorId], references: [id])
  tipo        String          @default("igual") // igual | custom
  divisiones  DivisionGasto[]
  fecha       DateTime        @default(now())
  creadoEn    DateTime        @default(now())

  @@index([grupoId])
  @@map("gastos_grupo")
}

model DivisionGasto {
  id        String       @id @default(cuid())
  gastoId   String
  gasto     GastoGrupo   @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  miembroId String
  miembro   MiembroGrupo @relation(fields: [miembroId], references: [id])
  monto     Decimal      @db.Decimal(15, 2)

  @@index([gastoId])
  @@map("divisiones_gasto")
}

model GrupoInvitacion {
  id       String     @id @default(cuid())
  grupoId  String
  grupo    GrupoGasto @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  email    String
  nombre   String?
  token    String     @unique @default(cuid())
  estado   String     @default("pendiente") // pendiente | aceptada | expirada
  creadoEn DateTime   @default(now())
  expiraEn DateTime

  @@index([grupoId])
  @@map("grupo_invitaciones")
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  profile   String // "organize" | "save_goals" | "invest" | "other"
  source    String? // canal de adquisición opcional (twitter, reddit, etc.)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("waitlist_entries")
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  message   String
  page      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("feedback")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  type      String
  currency  String
  buyRate   Decimal  @db.Decimal(10, 4)
  sellRate  Decimal  @db.Decimal(10, 4)
  fetchedAt DateTime @default(now())

  @@index([type, currency, fetchedAt])
  @@map("exchange_rates")
}

// ─────────────────────────────────────────────
// WHATSAPP BOT (Kapso) — el asesor financiero por WhatsApp
// Estas tablas se escriben por SQL directo desde lib/whatsapp/*.
// Se modelan acá solo para que Prisma las conozca y `migrate diff`
// no las marque como drift. NO tienen FK a profiles (user_id es el
// número de WhatsApp, no el id de Profile).
// ─────────────────────────────────────────────

model WhatsappChatHistory {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, id], map: "wch_user_idx")
  @@map("whatsapp_chat_history")
}

model WhatsappMemory {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id")
  fact      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "wm_user_idx")
  @@map("whatsapp_memory")
}

model WhatsappProcessedMessage {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("whatsapp_processed_messages")
}

// Correos ya notificados por el vigilante de UTN (dedup: no avisar 2 veces el
// mismo correo). id = Message-ID del correo.
model EmailNotified {
  messageId String   @id @map("message_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("email_notified")
}

// ─────────────────────────────────────────────
// ESTUDIO (apuntes + repaso espaciado) — solo dueño
// summary/content cifrados. Sin FK a profiles (userId como String, patrón de
// las tablas de whatsapp) para no tocar el modelo Profile.
// ─────────────────────────────────────────────
model StudyNote {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  subject   String // materia
  title     String
  summary   String // resumen generado (cifrado)
  content   String? // texto original extraído (cifrado)
  source    String   @default("text") // text | audio | pdf
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, subject])
  @@index([userId, createdAt])
  @@map("study_notes")
}

model StudyReview {
  id        String    @id @default(cuid())
  noteId    String    @map("note_id")
  userId    String    @map("user_id")
  subject   String
  title     String
  dueDate   DateTime  @map("due_date")
  interval  Int // repaso a los N días (1,3,7,16…)
  done      Boolean   @default(false)
  doneAt    DateTime? @map("done_at")
  sent      Boolean   @default(false) // recordatorio ya enviado
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([done, sent, dueDate])
  @@index([userId, done, dueDate])
  @@map("study_reviews")
}

// ─────────────────────────────────────────────
// SISTEMA DE ESTUDIO POR REPETICIÓN ESPACIADA (solo dueño)
// Materias → bloques (tema manejable) → sesiones. El bloque tiene una única
// próxima fecha activa; el motor la recalcula según el resultado.
// ─────────────────────────────────────────────
model StudySubject {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  name          String
  code          String // AM2, FIS2, ASI, PDP, SO…
  type          String   @default("cuatrimestral") // anual | cuatrimestral
  color         String?
  active        Boolean  @default(true)
  groupLabel    String   @default("Unidad") @map("group_label") // cómo llama a su agrupación: Unidad | Capítulo | Módulo…
  notebookPages Int      @default(0) @map("notebook_pages") // páginas ya procesadas del cuaderno PDF
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId, active])
  @@map("study_subjects")
}

model StudyUnit {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  subjectId String   @map("subject_id")
  name      String // "Unidad 1", "Capítulo 3: Magnetismo", …
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, subjectId])
  @@map("study_units")
}

model StudyBlock {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  subjectId         String    @map("subject_id")
  unitId            String?   @map("unit_id") // FK a StudyUnit (agrupación)
  code              String // AM2-P2-03
  unit              String? // unidad (texto legacy; se reemplaza por unitId)
  topic             String // tema
  orderIndex        Int       @default(0) @map("order_index") // orden manual dentro de la materia/unidad
  initialSessions   Int       @default(1) @map("initial_sessions") // sesiones de estudio inicial del tema
  initialDone       Int       @default(0) @map("initial_done") // cuántas ya se hicieron
  subtopic          String?
  summary           String? // cifrado
  source            String? // fuente/archivo/páginas
  importance        Int       @default(2) // 1 baja … 4 muy alta
  difficulty        Int       @default(2) // 1..4
  masteryLevel      String    @default("ROJO") @map("mastery_level") // ROJO|AMARILLO|VERDE|CONSOLIDADO
  reviewStage       String    @default("D0") @map("review_stage") // D0|D+1|D+3|D+7|D+16|MANT_SEM|MANT_QUIN
  reviewDuration    Int       @default(25) @map("review_duration") // min estimados del próximo repaso
  incorporationDate DateTime  @default(now()) @map("incorporation_date")
  lastStudyDate     DateTime? @map("last_study_date")
  nextReviewDate    DateTime? @map("next_review_date")
  reviewCount       Int       @default(0) @map("review_count")
  successCount      Int       @default(0) @map("success_count")
  errorCount        Int       @default(0) @map("error_count")
  status            String    @default("ACTIVO") // ACTIVO|PAUSADO|ARCHIVADO
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([userId, nextReviewDate])
  @@index([subjectId])
  @@map("study_blocks")
}

model StudySession {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  blockId               String    @map("block_id")
  sessionType           String    @map("session_type") // ESTUDIO_INICIAL|RECUPERACION_ACTIVA|EJERCICIOS|...
  stage                 String
  masteryBefore         String    @map("mastery_before")
  masteryAfter          String    @map("mastery_after") // resultado ROJO|AMARILLO|VERDE|CONSOLIDADO
  plannedDuration       Int?      @map("planned_duration")
  actualDuration        Int?      @map("actual_duration")
  explainedWithoutNotes Boolean?  @map("explained_without_notes")
  solvedWithoutHelp     Boolean?  @map("solved_without_help")
  usedNotes             Boolean?  @map("used_notes")
  errorCategory         String?   @map("error_category")
  errorDescription      String?   @map("error_description") // cifrado
  notes                 String? // cifrado
  nextDateCalculated    DateTime? @map("next_date_calculated")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@index([userId, blockId])
  @@index([blockId, createdAt])
  @@map("study_sessions")
}

model StudyAvailability {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  dayOfWeek Int      @map("day_of_week") // 0=Dom … 6=Sáb
  minutes   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, dayOfWeek])
  @@map("study_availability")
}

model StudyExam {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  subjectId  String   @map("subject_id")
  title      String
  examDate   DateTime @map("exam_date")
  importance Int      @default(3)
  notes      String?
  done       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, examDate])
  @@index([subjectId])
  @@map("study_exams")
}

model StudyFlashcard {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  blockId    String   @map("block_id")
  question   String
  answer     String // cifrado
  box        Int      @default(0) // Leitner: 0..5
  nextReview DateTime @default(now()) @map("next_review")
  reviews    Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([blockId])
  @@index([userId, nextReview])
  @@map("study_flashcards")
}

model SupportTicket {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  fromName    String?   @map("from_name")
  fromContact String?   @map("from_contact")
  motivo      String
  status      String    @default("abierto") // abierto | resuelto
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  @@index([status, createdAt])
  @@map("support_tickets")
}

model StudySettings {
  userId        String   @id @map("user_id")
  planHour      Int      @default(8) @map("plan_hour")
  planMinute    Int      @default(0) @map("plan_minute")
  notifyEnabled Boolean  @default(true) @map("notify_enabled")
  lastPlanSent  String?  @map("last_plan_sent") // "YYYY-MM-DD" ARG del último envío
  notionToken   String?  @map("notion_token") // cifrado
  notionDbId    String?  @map("notion_db_id")
  icsToken      String?  @map("ics_token") // secreto para la URL del calendario
  gcalIcsUrl    String?  @map("gcal_ics_url") // URL secreta iCal de Google (cifrada)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([icsToken])
  @@map("study_settings")
}

model StudyExercise {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  blockId     String?   @map("block_id")
  subjectId   String?   @map("subject_id")
  description String // cifrado
  source      String?
  done        Boolean   @default(false)
  doneAt      DateTime? @map("done_at")
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, done])
  @@index([blockId])
  @@map("study_exercises")
}

// Registro de números que escribieron al bot sin estar vinculados. Sirve para
// diagnosticar si un número YA vinculado falla el matcheo (bug real) vs un
// tester que todavía no vinculó (comportamiento esperado).
model WhatsappUnmatched {
  id        BigInt   @id @default(autoincrement())
  fromRaw   String   @map("from_raw")
  tail      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("whatsapp_unmatched")
}

// Días (ARG) en los que el usuario estuvo activo (abrió la app). Junto con los
// días con movimientos, alimenta la racha — así un día sin gastos no la corta
// si el usuario igual entró a revisar.
model UserActiveDay {
  userId String   @map("user_id")
  day    DateTime @db.Date

  @@id([userId, day])
  @@map("user_active_days")
}

// ─────────────────────────────────────────────
// NEWSLETTER (noticias personalizadas diarias)
// ─────────────────────────────────────────────

model NewsletterConfig {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics                 String[] // temas de interés del usuario
  priorityTopics         String[] // subconjunto de topics que la IA pondera primero
  language               String    @default("es")
  country                String    @default("ar")
  isActive               Boolean   @default(true)
  sendHour               Int       @default(8) // hora ARG (0–23) de la generación automática diaria
  sendHour2              Int? // segunda ventana opcional (solo Mi Brief)
  sendHour3              Int? // tercera ventana opcional (solo Mi Brief)
  lastDeliveryKey        String? // evita repetir un aviso: "YYYY-MM-DD:HH"
  notifyOnReady          Boolean   @default(true) // (legacy) master del aviso; se conserva por compat
  notifyPush             Boolean   @default(true) // avisar por PUSH cuando la edición esté lista
  notifyWhatsapp         Boolean   @default(true) // avisar por WHATSAPP cuando la edición esté lista
  discoveryLevel         String    @default("BALANCED") // CONSERVATIVE | BALANCED | EXPLORER
  briefLength            String    @default("NORMAL") // SHORT | NORMAL | WIDE
  localSourcesMigratedAt DateTime? // migración única desde controlio:my-circle:v1
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@map("newsletter_configs")
}

model NewsletterEdition {
  id            String      @id @default(cuid())
  userId        String
  user          Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime // día de la edición (medianoche local)
  summary       String // análisis general del día (texto plano)
  articles      Json // [{ title, source, url, topic, summary, publishedAt }]
  isRead        Boolean     @default(false)
  completedAt   DateTime?
  reviewedCount Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  briefItems    BriefItem[]

  @@unique([userId, date])
  @@index([userId, date])
  @@map("newsletter_editions")
}

// Fuente elegida explícitamente por el usuario. No representa una recomendación
// ni se completa automáticamente con perfiles parecidos.
model BriefSource {
  id             String          @id @default(cuid())
  userId         String
  user           Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  sourceType     String          @default("ACCOUNT") // PERSON | MEDIA | ACCOUNT
  category       String          @default("REFERENCE") // CLOSE | REFERENCE | MEDIA | COMPETITOR | INSPIRATION
  normalizedKey  String
  priority       Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  socialAccounts SocialAccount[]
  briefItems     BriefItem[]

  @@unique([userId, normalizedKey])
  @@index([userId, isActive, priority])
  @@map("brief_sources")
}

model SocialAccount {
  id           String       @id @default(cuid())
  sourceId     String
  source       BriefSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  platform     String
  handle       String
  profileUrl   String
  externalId   String?
  status       String       @default("PENDING") // PENDING | ACTIVE | PRIVATE | NOT_FOUND | UNAVAILABLE
  lastSyncedAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  posts        SocialPost[]

  @@unique([sourceId, platform, handle])
  @@index([platform, handle])
  @@map("social_accounts")
}

model SocialPost {
  id           String        @id @default(cuid())
  accountId    String
  account      SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId   String
  url          String
  title        String
  thumbnailUrl String?
  publishedAt  DateTime?
  metrics      Json?
  topicSignals Json?
  fetchedAt    DateTime      @default(now())
  createdAt    DateTime      @default(now())
  briefItems   BriefItem[]

  @@unique([accountId, externalId])
  @@index([accountId, publishedAt])
  @@map("social_posts")
}

// Representación normalizada de una pieza dentro de una edición. `articles`
// se conserva en NewsletterEdition para compatibilidad con ediciones previas.
model BriefItem {
  id              String            @id @default(cuid())
  editionId       String
  edition         NewsletterEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  contentKey      String
  kind            String // NEWS | SOCIAL | DISCOVERY
  sourceType      String
  sourceId        String?
  source          BriefSource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  socialPostId    String?
  socialPost      SocialPost?       @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  title           String
  summary         String
  url             String
  topic           String?
  publishedAt     DateTime?
  rank            Int
  section         String // KEYS | SOURCES | TOPICS | RADAR
  inclusionReason String?
  metadata        Json?
  createdAt       DateTime          @default(now())

  @@unique([editionId, contentKey])
  @@index([editionId, section, rank])
  @@index([sourceId])
  @@map("brief_items")
}

model DiscoveryCandidate {
  id            String   @id @default(cuid())
  userId        String
  user          Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  candidateType String   @default("ACCOUNT") // PERSON | MEDIA | ACCOUNT | POST
  sourceName    String
  platform      String?
  handle        String?
  profileUrl    String
  topic         String?
  score         Float?
  explanation   String
  signals       Json?
  status        String   @default("PENDING") // PENDING | ADDED | TODAY_ONLY | DISMISSED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date, profileUrl])
  @@index([userId, date, status])
  @@map("discovery_candidates")
}

model BriefFeedback {
  id         String   @id @default(cuid())
  userId     String
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  action     String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId, action])
  @@index([userId, createdAt])
  @@map("brief_feedback")
}
